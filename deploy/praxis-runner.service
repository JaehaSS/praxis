[Unit]
Description=Praxis headless runner
After=network-online.target
# 기본 rate limit(10초에 5회)에 걸리면 systemd가 재시작을 포기하고 failed로 둔다. 원격에서만
# 접근하는 서비스라 그 상태를 아무도 눈치채지 못하므로 제한을 푼다.
# (Service가 아니라 Unit 섹션에 두어야 적용된다 — systemd 229+)
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PRAXIS_RUNNER_CONFIG=%h/.config/praxis/runner.toml
Environment=PRAXIS_RUNNER_DB=%h/.local/share/praxis/runner.sqlite
# systemd user 기본 PATH에는 ~/.local/bin이 없어 agent CLI(claude/codex 등)를 찾지 못한다.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/praxis-runner
# on-failure는 깨끗한 종료(exit 0)와 OOM kill을 재시작하지 않는다 — 데스크톱 앱이 언제든
# 붙을 수 있어야 하는 상시 서비스이므로 종료 사유와 무관하게 되살린다.
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
