+"""Atomic legacy JSONL export for verified learning events."""
+
+import json
+import os
+from pathlib import Path
+
+from project_learning_publish import write_all
+from project_learning_events import encode_legacy
+from project_learning_storage import MAX_LINE_BYTES
+
+
+def export_jsonl(output: str, events: list[dict], error_type: type[Exception]) -> str:
+    lines = [_legacy_line(event, error_type) for event in events]
+    target = Path(output).expanduser()
+    if not target.is_absolute():
+        target = Path.cwd() / target
+    parent_fd = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0))
+    temporary = ".tmp-project-learning-" + os.urandom(16).hex()
+    try:
+        _publish(parent_fd, target.name, temporary, lines)
+    except OSError as error:
+        raise error_type("cannot publish export safely") from error
+    finally:
+        os.close(parent_fd)
+    return str(target)
+
+
+def _legacy_line(event: dict, error_type: type[Exception]) -> bytes:
+    encoded = encode_legacy(event)
+    if len(encoded) + 1 > MAX_LINE_BYTES:
+        raise error_type("learning event exceeds legacy line limit")
+    return encoded + b"\n"
+
+
+def _publish(parent_fd: int, name: str, temporary: str, lines: list[bytes]) -> None:
+    try:
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+        descriptor = os.open(temporary, flags, 0o600, dir_fd=parent_fd)
+        try:
+            for line in lines:
+                write_all(descriptor, line)
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        os.link(temporary, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd, follow_symlinks=False)
+        os.fsync(parent_fd)
+    except FileExistsError:
+        raise OSError("export output already exists") from None
+    finally:
+        try:
+            os.unlink(temporary, dir_fd=parent_fd)
+        except FileNotFoundError:
+            pass
