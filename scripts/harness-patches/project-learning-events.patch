+    def run_cli(self, command, *args, root=None, data=None, check=True):
+        target = root or self.root
+        result = subprocess.run(
+            [sys.executable, str(CLI), command, "--project", str(target), *args],
+            input=None if data is None else json.dumps(data, ensure_ascii=False),
+            text=True,
+            capture_output=True,
+            check=False,
