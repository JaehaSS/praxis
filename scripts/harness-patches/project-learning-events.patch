+"""Event identity and schema validation for project learnings."""
+
+import hashlib
+import json
+import math
+
+
+SCHEMA_VERSION = 1
+TEXT_FIELDS = ("condition", "failed_approach", "correction", "evidence")
+TRIGGERS = {"user-correction", "failed-approach", "recurrence", "risk"}
+
+
+def canonical_bytes(value: object) -> bytes:
+    return json.dumps(
+        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False
+    ).encode("utf-8")
+
+
+def encode_envelope(envelope: dict) -> bytes:
+    return json.dumps(envelope, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+
+
+def encode_legacy(event: dict) -> bytes:
+    return json.dumps(event, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")
+
+
+def event_key(event: dict) -> str:
+    return hashlib.sha256(canonical_bytes(event)).hexdigest()
+
+
+def event_filename(event: dict) -> str:
+    if event["type"] == "learning":
+        identity = {"id": event["id"], "type": "learning"}
+        return hashlib.sha256(canonical_bytes(identity)).hexdigest() + ".json"
+    return event_key(event) + ".json"
+
+
+def valid_event(event: object, strict: bool = False) -> bool:
+    if not isinstance(event, dict) or not isinstance(event.get("type"), str):
+        return False
+    if event["type"] == "learning":
+        return (
+            isinstance(event.get("id"), str)
+            and isinstance(event.get("ts"), str)
+            and isinstance(event.get("trigger"), str)
+            and event["trigger"] in TRIGGERS
+            and all(isinstance(event.get(field), str) for field in TEXT_FIELDS)
+            and isinstance(event.get("tags", []), list)
+            and all(isinstance(tag, str) for tag in event.get("tags", []))
+        )
+    return event["type"] == "retire" and all(
+        isinstance(event.get(field), str) for field in ("id", "reason", "ts")
+    )
+
+
+def valid_envelope(value: object, filename: str) -> tuple[dict, int | None] | None:
+    if not isinstance(value, dict) or type(value.get("version")) is not int or value["version"] != SCHEMA_VERSION:
+        return None
+    if set(value) - {"version", "event", "legacy_index"} or "event" not in value:
+        return None
+    event = value["event"]
+    legacy_index = value.get("legacy_index")
+    if not valid_event(event, strict=True) or not finite_json(event) or event_filename(event) != filename:
+        return None
+    if "legacy_index" in value and (
+        not isinstance(legacy_index, int) or isinstance(legacy_index, bool) or legacy_index < 0
+    ):
+        return None
+    return event, legacy_index
+
+
+def finite_json(value: object) -> bool:
+    if isinstance(value, float):
+        return math.isfinite(value)
+    if isinstance(value, dict):
+        return all(finite_json(item) for item in value.values())
+    if isinstance(value, list):
+        return all(finite_json(item) for item in value)
+    return True
