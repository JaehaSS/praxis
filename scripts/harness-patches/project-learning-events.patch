+"""Atomic no-clobber file publication helpers."""
+
+import os
+
+
+def write_all(descriptor: int, data: bytes) -> None:
+    while data:
+        written = os.write(descriptor, data)
+        if written <= 0:
+            raise OSError("cannot write learning storage")
+        data = data[written:]
+
+
+def publish_bytes(directory_fd: int, filename: str, data: bytes) -> bool:
+    temporary = ".tmp-" + os.urandom(16).hex()
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
+    try:
+        descriptor = os.open(temporary, flags, 0o600, dir_fd=directory_fd)
+        try:
+            write_all(descriptor, data)
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        os.link(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd, follow_symlinks=False)
+    except FileExistsError:
+        return False
+    finally:
+        try:
+            os.unlink(temporary, dir_fd=directory_fd)
+        except FileNotFoundError:
+            pass
+    os.fsync(directory_fd)
+    return True
