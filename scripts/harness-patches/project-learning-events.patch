+def _read_all(descriptor: int) -> bytes:
+    chunks, size = [], 0
+    while chunk := os.read(descriptor, MAX_EVENT_BYTES + 1):
+        chunks.append(chunk)
+        size += len(chunk)
+        if size > MAX_EVENT_BYTES:
+            raise ValueError("learning event is too large")
+    return b"".join(chunks)
