{
  "schema_version": 1,
  "project_ref": "github.com/example/praxis",
  "base_commit": "0123456789abcdef0123456789abcdef01234567",
  "phases": [
    { "id": "implement", "name": "Implement", "order": 1 },
    { "id": "integrate", "name": "Integrate", "order": 2 }
  ],
  "tasks": [
    {
      "id": "api",
      "phase_id": "implement",
      "kind": "agent",
      "objective": "Implement the API contract.",
      "write_paths": ["src/api"],
      "resource_requests_by_step": {
        "execute": [{ "resource_id": "repo:example:path:src/api", "mode": "exclusive_write", "units": 1 }]
      },
      "input_artifacts": [],
      "output_contract": { "include_paths": ["src/api"], "exclude_paths": ["src/api/generated"] },
      "checks": [{ "id": "api-tests", "profile_id": "cargo-test-v1" }],
      "manual_acceptance": ["API error messages are clear."],
      "retry_policy": { "max_attempts": 2, "auto_retry_transient": true }
    },
    {
      "id": "ui",
      "phase_id": "implement",
      "kind": "command",
      "objective": "Build the UI client.",
      "write_paths": ["src/lib/workflow"],
      "resource_requests_by_step": {},
      "input_artifacts": [],
      "output_contract": { "include_paths": ["src/lib/workflow"], "exclude_paths": [] },
      "checks": [{ "id": "ui-tests", "profile_id": "vitest-v1" }],
      "manual_acceptance": [],
      "retry_policy": { "max_attempts": 1, "auto_retry_transient": false },
      "command_profile_id": "ui-build-v1"
    },
    {
      "id": "final-integration",
      "phase_id": "integrate",
      "kind": "integration",
      "objective": "Verify the combined candidate snapshot.",
      "write_paths": ["tests/workflow"],
      "resource_requests_by_step": {
        "integrate": [{ "resource_id": "repo:example:path:tests/workflow", "mode": "exclusive_write", "units": 1 }]
      },
      "input_artifacts": [
        { "task_id": "api", "artifact": "delta" },
        { "task_id": "ui", "artifact": "delta" }
      ],
      "output_contract": { "include_paths": ["tests/workflow"], "exclude_paths": [] },
      "checks": [{ "id": "integration-tests", "profile_id": "cargo-test-v1" }],
      "manual_acceptance": ["The combined workflow is ready for review."],
      "retry_policy": { "max_attempts": 1, "auto_retry_transient": false }
    }
  ],
  "edges": [
    { "from": "api", "to": "final-integration" },
    { "from": "ui", "to": "final-integration" }
  ],
  "final_task_id": "final-integration",
  "execution_profile_id": "podman-rootless-v1",
  "limits": {
    "max_tasks": 3,
    "max_edges": 2,
    "max_attempts_per_task": 3,
    "max_concurrent_tasks": 2
  }
}
