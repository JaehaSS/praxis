{
  "type": "namespace",
  "name": "praxis_ui",
  "description": "Praxis user clarification UI. Never use for secrets or tool approvals.",
  "tools": [
    {
      "type": "function",
      "name": "ask_user",
      "description": "Ask 1-3 ordinary clarifications. The host waits for the user's answers. Use only this tool for user questions. Never request credentials or execution permissions.",
      "deferLoading": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "questions"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "clarification"
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "question",
                "options",
                "allow_free_text",
                "is_secret"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "allow_free_text": {
                  "type": "boolean"
                },
                "is_secret": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                "options": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "description"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
