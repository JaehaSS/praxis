<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tauri v2 는 번들 시 이 파일을 생성 plist 에 병합한다.
  마이크 사용 설명이 없으면 macOS 가 권한 프롬프트 없이 캡처를 막는다(Plan 0043 Task 9).
-->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>음성 커맨드와 프롬프트 받아쓰기를 위해 마이크를 사용합니다.</string>
  </dict>
</plist>
